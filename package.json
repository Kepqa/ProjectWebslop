  "dependencies": {
    "@capacitor/core": "8.6.0",
    "peerjs": "^1.5.5",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
